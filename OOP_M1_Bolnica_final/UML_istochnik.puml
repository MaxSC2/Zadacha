@startuml УМЛ_Больница
' === Редактируемый источник UML-диаграммы классов ===
' Модель «Больница» (ООП, Модуль 1) — источник истины: код hospital_project
' Связи: только обобщение, композиция, агрегация, ассоциация. DEPENDENCY COUNT = 0.
skinparam backgroundColor white
skinparam defaultFontName "Liberation Sans"
skinparam classAttributeFontSize 11
skinparam classFontSize 13
skinparam linetype ortho

skinparam class {
  BackgroundColor white
  BorderColor #1b7a43
  ArrowColor #1c2733
}

package "Иерархия персон" #E7F4EC {
  abstract class Человек {
    # фио : строка
    # датаРождения : дата
    # телефон : строка
    + получитьВозраст() : число
    + получитьКонтакты() : строка
  }
  class Пациент {
    - полисОМС : строка
    - карта : МедицинскаяКарта
    + завестиКарту(карта)
    + записатьсяНаПриём(врач, дата) : Приём
    + отменитьЗапись(приём, причина)
    + получитьИсторию() : список
  }
  abstract class МедицинскийПерсонал {
    # табельныйНомер : строка
    # стажЛет : число
    + получитьИнформацию() : строка {abstract}
  }
  class Врач {
    - специальность : строка
    - категория : строка
    - приёмы : список
    + получитьИнформацию() : строка
    + провестиПриём(приём, диагноз, назначения)
  }
  class Медсестра {
    - профиль : строка
    - смена : строка
    + получитьИнформацию() : строка
    + подготовитьКабинет(отделение)
    + сопроводитьПациента(пациент)
  }
}

package "Организационная структура" #E8EFF8 {
  class Больница {
    - название : строка
    - адрес : строка
    - отделения : список
    + добавитьОтделение(название, расположение) : Отделение
    + найтиВрачей(специальность) : список
    + получитьСтатистику() : словарь
  }
  class Отделение {
    - название : строка
    - расположение : строка
    - персонал : список
    + закрепитьСотрудника(сотрудник)
    + получитьРасписание() : список
  }
}

package "Медицинский процесс" #FAF3E3 {
  class МедицинскаяКарта {
    - номер : строка
    - датаЗаведения : дата
    - записи : список
    + добавитьЗапись(приём)
    + получитьИсторию() : список
  }
  class Приём {
    - датаВремя : дата и время
    - статус : строка
    - диагноз : строка
    - назначения : строка
    + перенести(новоеВремя)
    + завершить(диагноз, назначения)
    + отменить(причина)
    + описать() : строка
  }
}

' --- Обобщение (4) ---
Человек <|-- Пациент
Человек <|-- МедицинскийПерсонал
МедицинскийПерсонал <|-- Врач
МедицинскийПерсонал <|-- Медсестра

' --- Композиция (2) ---
Больница "1" *-- "1..*" Отделение : владеет
Пациент "1" *-- "0..1" МедицинскаяКарта : владеет

' --- Агрегация (1) ---
Отделение "1" o-- "1..*" МедицинскийПерсонал : закреплён

' --- Ассоциация (3) ---
Пациент "1" -- "0..*" Приём : записывается
Врач "1" -- "0..*" Приём : проводит
МедицинскаяКарта "0..1" -- "0..*" Приём : фиксируется

note bottom of Приём
  Статусы приёма: запланирован / завершён / отменён (причина).
  Завершённый приём сам дописывается в карту пациента
  (Appointment.complete -> MedicalCard.add_record).
end note
@enduml
